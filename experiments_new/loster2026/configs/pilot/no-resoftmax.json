    "metrics": [
      "ARI",
      "NMI_arithmetic",
      "RI",
      "ACC"
    ],
    "instance_norm_eps": 1e-12,
    "legacy_cosine_eps": 1e-08,
    "noresoftmax_entropy_eps": 1e-08,
    "noresoftmax_count_norm_floor": 1.0,
    "self_mask": 1000000000.0,
    "gradient_epochs": [
      0,
      1,
      4,
      9,
      19,
      39,
      59,
      79,
      99
    ],
    "gradient_diagnostics": true,
    "near_collapse_fraction": 0.98,
    "device": "auto"
  }
