{
  "specification": "analysis/audits/04-method-and-experiment-plan.md",
  "datasets": [
    "SyntheticControl",
    "Beef",
    "ECG200",
    "OSULeaf",
    "ShapesAll",
    "SemgHandMovementCh2",
    "CinCECGTorso",
    "StarLightCurves"
  ],
  "seeds": [
    0,
    1,
    2,
    3,
    4
  ],
  "base": {
    "dataset": "SyntheticControl",
    "seed": 0,
    "variant": "LoSTer-NoResoftmax",
    "latent_dim": 256,
    "encoder_blocks": 3,
    "decoder_blocks": 3,
    "dropout": 0.1,
    "layer_norm_eps": 1e-05,
    "pretrain_epochs": 50,
    "joint_epochs": 100,
    "batch_size": 128,
    "small_n_batch_rule": "min(batch_size,N)",
