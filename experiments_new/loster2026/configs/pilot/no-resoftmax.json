    "pretrain_optimizer": "Adam",
    "pretrain_lr": 0.001,
    "adam_betas": [
      0.9,
      0.999
    ],
    "adam_eps": 1e-08,
    "optimizer": "SGD",
    "joint_lr": 0.01,
    "momentum": 0.0,
    "weight_decay": 0.0,
    "scheduler": "StepLR",
    "scheduler_step": 5,
    "scheduler_gamma": 0.1,
    "tau_initial": 10.0,
    "beta": 0.65,
    "tau_minimum": 0.01,
    "sigma": 1.0,
    "instance_temperature": 1.0,
    "cluster_temperature": 1.0,
    "alpha": 1.0,
    "stopping_tolerance": 0.001,
    "stopping_first_epoch": 2,
